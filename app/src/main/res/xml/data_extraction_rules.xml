<?xml version="1.0" encoding="utf-8"?>
<!-- API keys are encrypted with an Android Keystore key that never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
